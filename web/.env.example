# The web app reads these at start (NEXT_PUBLIC_* at build). Values here are examples, not secrets.

# 1 serves constructed demonstration data and needs nothing below.
NEXT_PUBLIC_DFU_MOCK=0

# The /api/v2 service the server-side proxy talks to.
DFU_API_URL=http://127.0.0.1:8000

# next-auth: the public URL of this app and a random secret for the session cookie.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# The organisation's OpenID Connect provider. The API must trust the same issuer (DFU_AUTH_ISSUER).
AUTH_OIDC_ISSUER=https://login.example.org
AUTH_OIDC_CLIENT_ID=dfu-web
# Leave empty for a public client with PKCE.
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_AUDIENCE=
AUTH_OIDC_NAME=your organisation
