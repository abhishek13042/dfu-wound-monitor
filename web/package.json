{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "node scripts/mock.mjs dev",
    "build": "next build",
    "start": "next start",
    "api:schema": "cd .. && python web/scripts/export_openapi.py web/openapi.json",
    "api:types": "openapi-typescript openapi.json -o lib/api/schema.d.ts",
    "api:check": "npm run api:schema && npm run api:types && git diff --exit-code -- openapi.json lib/api/schema.d.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:wording": "node scripts/check-wording.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "next": "^15.5.9",
    "next-auth": "^4.24.15",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oauth2-mock-server": "^9.3.0",
    "openapi-typescript": "^7.13.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
