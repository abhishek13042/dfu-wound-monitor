{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dfu-api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "src.api.app:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "web-build",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "start", "--", "-p", "3002"],
      "port": 3002
    }
  ]
}
