{
  "experiment_id": "P02-SPEC-02-03-fuseg2021-resnet34-unet-512-v1",
  "specification": "SPEC-02-03",
  "description": "ImageNet-pretrained ResNet34 U-Net at native 512px with strong synchronized augmentation, AdamW + warmup/cosine, AMP and EMA. Selection on internal validation; official FUSeg2021 validation is the held-out test.",
  "data": {
    "dataset_name": "FUSeg2021",
    "dataset_source_type": "real",
    "annotation_type": "wound_segmentation",
    "manifest_path": "data/manifests/fuseg2021_heldout_manifest.json",
    "required_manifest_version": "fuseg2021-heldout-v1",
    "data_root": null
  },
  "preprocessing": {
    "input_height": 512,
    "input_width": 512,
    "normalize_mean": [0.485, 0.456, 0.406],
    "normalize_std": [0.229, 0.224, 0.225],
    "mask_threshold": 128,
    "source_mask_values": [0, 255]
  },
  "augmentation": {
    "horizontal_flip_prob": 0.5,
    "vertical_flip_prob": 0.5,
    "rotate90_prob": 0.5,
    "affine_prob": 0.7,
    "rotation_degrees": 30.0,
    "scale_range": [0.75, 1.25],
    "translate_fraction": 0.1,
    "shear_degrees": 5.0,
    "color_prob": 0.8,
    "brightness": 0.25,
    "contrast": 0.25,
    "saturation": 0.25,
    "hue": 0.04,
    "blur_prob": 0.15,
    "blur_sigma_range": [0.1, 1.5],
    "validation_and_test": "none"
  },
  "model": {
    "architecture": "ResNetUNet",
    "encoder_name": "resnet34",
    "pretrained": true,
    "decoder_channels": [256, 128, 64, 32, 16],
    "num_classes": 1
  },
  "loss": {
    "name": "BCEDiceLoss",
    "bce_weight": 0.5,
    "dice_weight": 0.5,
    "epsilon": 1e-6
  },
  "training": {
    "num_epochs": 100,
    "batch_size": 8,
    "num_workers": 4,
    "pin_memory": true,
    "persistent_workers": true,
    "random_seed": 42,
    "deterministic": false,
    "optimizer": "AdamW",
    "learning_rate": 0.0003,
    "encoder_lr_multiplier": 0.3,
    "weight_decay": 0.0001,
    "scheduler": {"name": "warmup_cosine", "warmup_epochs": 3, "min_lr_ratio": 0.01},
    "mixed_precision": true,
    "gradient_clip_norm": 1.0,
    "ema_decay": 0.999,
    "early_stopping_patience": 25,
    "resume_checkpoint": null
  },
  "checkpointing": {
    "checkpoint_dir": "models/checkpoints/spec-02-03",
    "checkpoint_filename_template": "resnet34_unet_512_best.pth",
    "latest_checkpoint_filename_template": "resnet34_unet_512_latest.pth",
    "checkpoint_selection_metric": "val_dice",
    "checkpoint_selection_mode": "max"
  },
  "evaluation": {
    "selection_threshold": 0.5,
    "tta": true,
    "tune_postprocessing_on": "val",
    "threshold_grid": [0.3, 0.35, 0.4, 0.45, 0.5, 0.55, 0.6, 0.65, 0.7],
    "min_component_area_grid": [0, 64, 128, 256, 512],
    "native_resolution": true,
    "include_hd95": true
  },
  "device": {"preferred": "cuda", "fallback": "cpu"},
  "output": {
    "output_root": "reports/experiments/spec-02-03",
    "log_file": "reports/experiments/spec-02-03/training_log.json",
    "postprocessing_tuning": "reports/experiments/spec-02-03/postprocessing_tuning.json",
    "test_evaluation": "reports/experiments/spec-02-03/heldout_test_evaluation.json",
    "external_evaluation": "reports/experiments/spec-02-03/lowerlimb_external_evaluation.json",
    "experiment_record": "reports/experiments/spec-02-03/experiment_record.json",
    "figure_dir": "reports/figures/spec-02-03"
  }
}
